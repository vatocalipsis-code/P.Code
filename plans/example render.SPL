  "Магазин Петровка данные" { SourceText = "Магазин Петровка\n1 200.00\nEUR" }
  "Требует моего подтверждения заголовок" { SourceText = "Требует моего подтверждения" }
  "Заявки на расход данные" { SourceText = "Заявки на расход\n5" SourcePicture = "example render.assets/expense-document.png" }
