}

SetRender {
  PanelSpacing = 12
  BackgroundColor = "#EEF4F8"
  PanelColor = "#F7FBFE"
  BorderColor = "#D5E0E8"
  TextColor = "#25313B"
  Transparency = 0
  TextTransparency = 0
  PictureTransparency = 0
  Parallax = NOT_YET_SPECIFIED

  Elements {
    "Example Render" { Padding = 12 Gap = 10 Alignment = Stretch Distribution = Start Direction = Vertical }
    "Мои кассы" { Background = "#EAF4FA" Padding = 12 Gap = 8 Alignment = Stretch Distribution = Start Direction = Vertical BorderWidth = 1 }
    "Мои кассы агрегат" { Background = "#F8FCFF" Height = 34 Padding = 6 Alignment = Center Distribution = Start Direction = Horizontal BorderWidth = 0 }
