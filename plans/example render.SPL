SetRender {
  PanelSpacing = 16

  BackgroundColor = "#F5F6F8"
  PanelColor = "#FFFFFF"
  BorderColor = "#E1E4E8"
  TextColor = "#1F2328"

  Transparency = 0
  TextTransparency = 0
  PictureTransparency = 0

  Parallax = NOT_YET_SPECIFIED
}
