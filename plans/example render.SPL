    "Требует моего подтверждения агрегат" { Background = "#F8FCFF" Height = 34 Padding = 6 Alignment = Center Distribution = Start Direction = Horizontal BorderWidth = 0 }
    "Требует моего подтверждения заголовок" { FontSize = 16 FontWeight = 700 Alignment = Center Distribution = Start Direction = Horizontal }
    "Заявки на расход" { Background = "#F8FCFF" Height = 58 Padding = 8 BorderWidth = 1 Alignment = Center Distribution = Start Direction = Horizontal }
